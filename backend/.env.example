# Copie este arquivo para ".env" e preencha com seus dados reais.
# Nunca suba o arquivo ".env" pro Git (ele já está no .gitignore).

# Exemplo local: postgresql://usuario:senha@localhost:5432/lojinha_grupo_oracao
DATABASE_URL="postgresql://usuario:senha@localhost:5432/lojinha_grupo_oracao"

PORT=3333

# Chave secreta usada pra assinar o token de login (JWT).
# Coloque qualquer texto longo e aleatório aqui — não precisa ser memorizável,
# só não pode ser previsível. Nunca compartilhe esse valor.
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"
